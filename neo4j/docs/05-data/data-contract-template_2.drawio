        <mxCell id="contract_b" parent="contract" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;fontColor=#1e293b;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;Analyst&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• id, name, version, status &lt;br&gt;• pairedContract (the other contract for the same table)&lt;br&gt;• source owner, consumer owner, data steward&lt;br&gt;• purpose, limitations&lt;br&gt;• canonicalModelVersion" vertex="1">
