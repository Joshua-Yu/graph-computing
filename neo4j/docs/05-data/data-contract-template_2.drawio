        <mxCell id="graphmodel_b" parent="graphmodel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;fontColor=#1e293b;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;Exported from spec/model/ — never edited here&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Canonical attribute&lt;/b&gt;: Party.partyId, PartyPhone.number …&lt;br&gt;• type, required, values / format, classification&lt;br&gt;• graph projection and temporal policy, for reference&lt;br&gt;• Version must equal Contract.canonicalModelVersion" vertex="1">
