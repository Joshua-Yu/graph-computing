        <mxCell id="schema_b" parent="schema" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;fontColor=#1e293b;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;Source owner&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Field&lt;/b&gt; (physical path), logical type , physical type&lt;br&gt;• required , unique , primary key &lt;br&gt;• classification &lt;br&gt;• description, example, valid values&lt;br&gt;• upstream column" vertex="1">
          <mxGeometry height="220" width="280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="mapping" parent="1" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;swimlaneFillColor=#fff8dc;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=6;fontFamily=Helvetica;" value="5 &amp;nbsp;·&amp;nbsp; Mapping" vertex="1">
          <mxGeometry height="250" width="280" x="760" y="485" as="geometry" />
        </mxCell>
        <mxCell id="mapping_b" parent="mapping" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;fontColor=#1e293b;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;Data engineer&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• Mapping ID&lt;br&gt;• Source field  (blank = constant)&lt;br&gt;• Canonical attribute  (or not-loaded)&lt;br&gt;• Transform , transform parameters&lt;br&gt;• condition&lt;br&gt;• date basis  (validFrom attributes only)&lt;br&gt;• notes&lt;br&gt;• All normalising and code translation happens here" vertex="1">
          <mxGeometry height="220" width="280" y="30" as="geometry" />
        </mxCell>
