        <mxCell id="lists" parent="1" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#7f7f7f;strokeColor=#7f7f7f;fontColor=#ffffff;swimlaneFillColor=#e7e6e6;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=6;fontFamily=Helvetica;" value="Lists" vertex="1">
          <mxGeometry height="200" width="280" x="1120" y="215" as="geometry" />
        </mxCell>
        <mxCell id="lists_b" parent="lists" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;fontColor=#1e293b;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;Maintained by data architecture&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• Fixed dropdown values: type, classification, change pattern, end signal, rule type, severity, action on breach …&lt;br&gt;• Feeds every  column that has no arrow in this diagram" vertex="1">
          <mxGeometry height="170" width="280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="quality" parent="1" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;swimlaneFillColor=#fff8dc;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=6;fontFamily=Helvetica;" value="6 &amp;nbsp;·&amp;nbsp; Quality" vertex="1">
          <mxGeometry height="250" width="280" x="40" y="485" as="geometry" />
        </mxCell>
        <mxCell id="quality_b" parent="quality" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;fontColor=#1e293b;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;Analyst with source owner&lt;/font&gt;&lt;/i&gt;&lt;br&gt;• Field  (blank = whole dataset)&lt;br&gt;• dimension , rule type , parameters&lt;br&gt;• check, in plain language&lt;br&gt;• threshold, severity &lt;br&gt;• action on breach &lt;br&gt;• Checks the source data; canonical conformance is checked automatically" vertex="1">
          <mxGeometry height="220" width="280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="schema" parent="1" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;swimlaneFillColor=#fff8dc;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=6;fontFamily=Helvetica;" value="3 &amp;nbsp;·&amp;nbsp; Schema" vertex="1">
