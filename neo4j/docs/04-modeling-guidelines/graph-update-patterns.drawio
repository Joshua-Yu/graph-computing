        <mxCell id="c8" edge="1" parent="1" source="c6" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#7c3aed;dashed=1;strokeWidth=1.5;" target="c7" value="&lt;b&gt;POSSIBLY_SAME_AS&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{score, method, matchedAt}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=4;fontSize=9;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;" value="{&lt;b&gt;partyId&lt;/b&gt; (key), crmId,&lt;br&gt;provenance}" vertex="1">
          <mxGeometry height="40" width="130" x="62" y="306" as="geometry" />
        </mxCell>
        <mxCell id="c10" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontFamily=Helvetica;" value="Entity resolution adds a link. Nodes are never merged and never deleted except by retention or privacy erasure." vertex="1">
          <mxGeometry height="40" width="390" x="52" y="358" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• One business key: &lt;b&gt;partyId&lt;/b&gt;. crmId is an indexed attribute, resolved to partyId upstream&lt;br&gt;• Match and then add if not existing (MERGE).&lt;br&gt;• Identity nodes (Phone, Email, IdentityDocument): the value is the key, so a changed value is a new node, never an edit&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="460" y="178" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="MERGE&amp;nbsp;(p:Party&amp;nbsp;{partyId:&amp;nbsp;$partyId})&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;p.crmId&amp;nbsp;=&amp;nbsp;$crmId,&amp;nbsp;p.sourceSystem&amp;nbsp;=&amp;nbsp;$sourceSystem,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;p.ingestedAt&amp;nbsp;=&amp;nbsp;datetime(),&amp;nbsp;p.loadId&amp;nbsp;=&amp;nbsp;$loadId&lt;br&gt;//&amp;nbsp;no&amp;nbsp;ON&amp;nbsp;MATCH:&amp;nbsp;identity&amp;nbsp;never&amp;nbsp;changes&lt;br&gt;//&amp;nbsp;Infinigraph&amp;nbsp;(D5):&amp;nbsp;key&amp;nbsp;known&amp;nbsp;to&amp;nbsp;be&amp;nbsp;new&amp;nbsp;upstream&amp;nbsp;-&amp;gt;&amp;nbsp;CREATE;&amp;nbsp;known&amp;nbsp;-&amp;gt;&amp;nbsp;skip" vertex="1">
          <mxGeometry height="124" width="796" x="52" y="408" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="880" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontFamily=Helvetica;" value="P2 · Relationship - Slow change, one valid instance per scope: open the new, close the old" vertex="1">
          <mxGeometry height="34" width="820" x="880" y="100" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; PartyName (per party); driver licence (per party + issuing state); passport (per party + country)." vertex="1">
          <mxGeometry height="32" width="796" x="892" y="140" as="geometry" />
        </mxCell>
