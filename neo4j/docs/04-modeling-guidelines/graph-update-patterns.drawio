        <mxCell id="c47" edge="1" parent="1" source="c40" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c43" value="&lt;b&gt;CREDITED_TO&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c48" edge="1" parent="1" source="c41" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c43" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c49" edge="1" parent="1" source="c42" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#16a34a;strokeWidth=2;" target="c43" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c50" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• CREATE once per event key (transactionId, alertId); a redelivered event is a no-op&lt;br&gt;• Never update: a correction or reversal is a new event that points to the original&lt;br&gt;• Order does not matter: events carry their own timestamp (bookedAt)&lt;br&gt;• Removed only by the rolling-window eviction job, never by the load&lt;br&gt;• Not for a value that supersedes the previous one: a RiskScore is P2 even when scored hourly&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="1300" y="658" as="geometry" />
        </mxCell>
        <mxCell id="c51" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="MATCH&amp;nbsp;(a:Account&amp;nbsp;{accountId:&amp;nbsp;$from}),&amp;nbsp;(b:Account&amp;nbsp;{accountId:&amp;nbsp;$to})&lt;br&gt;MERGE&amp;nbsp;(t:Transaction&amp;nbsp;{transactionId:&amp;nbsp;$txId})&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;t.amountMinor&amp;nbsp;=&amp;nbsp;$amountMinor,&amp;nbsp;t.currency&amp;nbsp;=&amp;nbsp;$ccy,&amp;nbsp;t.bookedAt&amp;nbsp;=&amp;nbsp;datetime($bookedAt),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;t.isNew&amp;nbsp;=&amp;nbsp;true&lt;br&gt;WITH&amp;nbsp;a,&amp;nbsp;b,&amp;nbsp;t&amp;nbsp;WHERE&amp;nbsp;t.isNew&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;only&amp;nbsp;the&amp;nbsp;first&amp;nbsp;delivery&amp;nbsp;continues&lt;br&gt;CREATE&amp;nbsp;(a)-[:SENT]-&amp;gt;(t)-[:CREDITED_TO]-&amp;gt;(b)&lt;br&gt;REMOVE&amp;nbsp;t.isNew&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;P7&amp;nbsp;summary&amp;nbsp;is&amp;nbsp;updated&amp;nbsp;in&amp;nbsp;this&amp;nbsp;same&amp;nbsp;transaction" vertex="1">
          <mxGeometry height="124" width="796" x="892" y="888" as="geometry" />
        </mxCell>
        <mxCell id="c52" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="40" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="c53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#FFFFFF;fontFamily=Helvetica;" value="P7 · Relationship - Fast change, summary only: one relationship updated in place" vertex="1">
          <mxGeometry height="34" width="820" x="40" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="c54" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; TRANSFERRED_TO between accounts; USED_DEVICE (sessionCount, lastSeenAt); SEEN_AT between device and IP" vertex="1">
          <mxGeometry height="32" width="796" x="52" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="c55" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Account&lt;br&gt;A" vertex="1">
          <mxGeometry height="70" width="70" x="77" y="1653" as="geometry" />
        </mxCell>
        <mxCell id="c56" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Account&lt;br&gt;B" vertex="1">
          <mxGeometry height="70" width="70" x="347" y="1653" as="geometry" />
        </mxCell>
        <mxCell id="c57" edge="1" parent="1" source="c55" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#16a34a;strokeWidth=2;" target="c56" value="&lt;b&gt;TRANSFERRED_TO&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{txCount: 12 → 13, totalAmountMinor += amount,&lt;br&gt;firstAt, lastAt = max(lastAt, bookedAt)}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c58" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Party" vertex="1">
          <mxGeometry height="50" width="50" x="87" y="1778" as="geometry" />
        </mxCell>
        <mxCell id="c59" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#4c8eda;strokeColor=#2870c2;fontColor=#ffffff;" value="Device" vertex="1">
          <mxGeometry height="50" width="50" x="357" y="1778" as="geometry" />
        </mxCell>
        <mxCell id="c60" edge="1" parent="1" source="c58" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#16a34a;strokeWidth=2;" target="c59" value="&lt;b&gt;USED_DEVICE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{firstSeenAt, lastSeenAt, sessionCount += 1}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c61" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• One relationship per pair, MERGE on the pair, then increment&lt;br&gt;• &lt;b&gt;Increment only when the underlying event is new&lt;/b&gt; (inside the P4 transaction), or a replay double-counts&lt;br&gt;• Lifetime aggregations. Rolling windows (e.g. last 30 days) is done separately.&lt;br&gt;• Must be rebuildable from P4 events or the archive&lt;br&gt;• High-degree accounts serialise on this one relationship: batch per pair&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="460" y="1618" as="geometry" />
        </mxCell>
        <mxCell id="c62" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="//&amp;nbsp;runs&amp;nbsp;inside&amp;nbsp;the&amp;nbsp;P4&amp;nbsp;transaction,&amp;nbsp;after&amp;nbsp;CREATE&amp;nbsp;(a)-[:SENT]-&amp;gt;(t)&lt;br&gt;MERGE&amp;nbsp;(a)-[s:TRANSFERRED_TO]-&amp;gt;(b)&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;s.txCount&amp;nbsp;=&amp;nbsp;0,&amp;nbsp;s.totalAmountMinor&amp;nbsp;=&amp;nbsp;0,&amp;nbsp;s.currency&amp;nbsp;=&amp;nbsp;$ccy,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s.firstAt&amp;nbsp;=&amp;nbsp;t.bookedAt&lt;br&gt;SET&amp;nbsp;s.txCount&amp;nbsp;=&amp;nbsp;s.txCount&amp;nbsp;+&amp;nbsp;1,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s.totalAmountMinor&amp;nbsp;=&amp;nbsp;s.totalAmountMinor&amp;nbsp;+&amp;nbsp;t.amountMinor,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;s.lastAt&amp;nbsp;=&amp;nbsp;CASE&amp;nbsp;WHEN&amp;nbsp;s.lastAt&amp;nbsp;IS&amp;nbsp;NULL&amp;nbsp;OR&amp;nbsp;t.bookedAt&amp;nbsp;&amp;gt;&amp;nbsp;s.lastAt&amp;nbsp;THEN&amp;nbsp;t.bookedAt&amp;nbsp;ELSE&amp;nbsp;s.lastAt&amp;nbsp;END" vertex="1">
          <mxGeometry height="102" width="796" x="52" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="c63" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="880" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c64" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontFamily=Helvetica;" value="P6 · Reference data: current snapshot, overwritten in place, no history" vertex="1">
          <mxGeometry height="34" width="820" x="880" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c65" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; Product code and name; G-NAF / DPID address attributes; country and currency codes" vertex="1">
          <mxGeometry height="32" width="796" x="892" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="c66" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Product" vertex="1">
          <mxGeometry height="66" width="66" x="919" y="1165" as="geometry" />
        </mxCell>
        <mxCell id="c67" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=4;fontSize=9;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;" value="{productId: &#39;Product 1&#39;, productName: &#39;Everyday Offset&#39;}&lt;br&gt;name looked up" vertex="1">
          <mxGeometry height="32" width="233" x="897" y="1236" as="geometry" />
        </mxCell>
        <mxCell id="c68" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#d9c8ae;strokeColor=#a8875a;fontColor=#1e293b;" value="Product 1" vertex="1">
          <mxGeometry height="76" width="76" x="1174" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="c70" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Party" vertex="1">
          <mxGeometry height="50" width="50" x="927" y="1293" as="geometry" />
        </mxCell>
        <mxCell id="c71" edge="1" parent="1" source="c70" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c68" value="&lt;b&gt;HAS_PRODUCT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;{P3 link}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c72" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• &lt;b&gt;Low-cardinality code lists stay properties&lt;/b&gt; (productCode); as nodes they become supernodes. Display names come from the reference table or Hume&lt;br&gt;• &lt;b&gt;High-cardinality reference entities are nodes&lt;/b&gt; (Address vs. DPID): attributes overwritten from each release, no history&lt;br&gt;• A retired code is never deleted while referenced: set isRetired and keep the node&lt;br&gt;• History lives in the party&#39;s links (P2, P3), not in the reference node&lt;br&gt;• Full load: upsert all, then flag what is absent&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="1300" y="1138" as="geometry" />
        </mxCell>
        <mxCell id="c73" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="UNWIND&amp;nbsp;$release&amp;nbsp;AS&amp;nbsp;row&lt;br&gt;MATCH&amp;nbsp;(ad:Address&amp;nbsp;{gnafPid:&amp;nbsp;row.gnafPid})&lt;br&gt;SET&amp;nbsp;ad.locality&amp;nbsp;=&amp;nbsp;row.locality,&amp;nbsp;ad.postcode&amp;nbsp;=&amp;nbsp;row.postcode,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ad.referenceVersion&amp;nbsp;=&amp;nbsp;$releaseId,&amp;nbsp;ad.ingestedAt&amp;nbsp;=&amp;nbsp;datetime()&lt;br&gt;//&amp;nbsp;after&amp;nbsp;the&amp;nbsp;release:&amp;nbsp;addresses&amp;nbsp;not&amp;nbsp;in&amp;nbsp;it&lt;br&gt;MATCH&amp;nbsp;(ad:Address)&amp;nbsp;WHERE&amp;nbsp;ad.gnafPid&amp;nbsp;IS&amp;nbsp;NOT&amp;nbsp;NULL&amp;nbsp;AND&amp;nbsp;ad.referenceVersion&amp;nbsp;&amp;lt;&amp;gt;&amp;nbsp;$releaseId&lt;br&gt;SET&amp;nbsp;ad.isRetired&amp;nbsp;=&amp;nbsp;true" vertex="1">
          <mxGeometry height="102" width="796" x="892" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="c74" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="40" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontFamily=Helvetica;" value="P5 · Fast change, high volume: append only, grouped per owner node and group key" vertex="1">
          <mxGeometry height="34" width="820" x="40" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="c76" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; Transaction for every account (uniform, e.g. by month); device sessions if kept individually" vertex="1">
          <mxGeometry height="32" width="796" x="52" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="c77" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Account&lt;br&gt;A" vertex="1">
          <mxGeometry height="70" width="70" x="62" y="1213" as="geometry" />
        </mxCell>
        <mxCell id="c78" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#57c7e3;strokeColor=#23b3d7;fontColor=#1e293b;" value="Txn Group&lt;br&gt;2026-09" vertex="1">
          <mxGeometry height="62" width="62" x="196" y="1152" as="geometry" />
        </mxCell>
        <mxCell id="c79" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#57c7e3;strokeColor=#23b3d7;fontColor=#1e293b;" value="Txn Group&lt;br&gt;2026-10" vertex="1">
          <mxGeometry height="62" width="62" x="196" y="1282" as="geometry" />
        </mxCell>
        <mxCell id="c80" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#57c7e3;strokeColor=#23b3d7;fontColor=#1e293b;" value="Txn" vertex="1">
          <mxGeometry height="40" width="40" x="377" y="1248" as="geometry" />
        </mxCell>
        <mxCell id="c81" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#57c7e3;strokeColor=#16a34a;strokeWidth=3;fontColor=#1e293b;" value="Txn&lt;br&gt;new" vertex="1">
          <mxGeometry height="40" width="40" x="377" y="1323" as="geometry" />
        </mxCell>
        <mxCell id="c82" edge="1" parent="1" source="c77" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c78" value="&lt;b&gt;HAS_TXN_GROUP&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c83" edge="1" parent="1" source="c77" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c79" value="&lt;b&gt;HAS_TXN_GROUP&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c84" edge="1" parent="1" source="c79" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c80" value="&lt;b&gt;SENT&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c85" edge="1" parent="1" source="c79" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#16a34a;strokeWidth=2;" target="c81" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c86" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontFamily=Helvetica;" value="Account degree = periods in the window. Counterparty side: (t)-[:CREDITED_TO]-&gt;(its own group)." vertex="1">
          <mxGeometry height="20" width="400" x="52" y="1366" as="geometry" />
        </mxCell>
        <mxCell id="c87" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• Group key: accountId + period (&#39;ACC123|2026-10&#39;). Created once (P1), ideally pre-created by a job at period start so writes are MATCH only&lt;br&gt;• Transaction itself is P4: CREATE once, never edited&lt;br&gt;• Uniform for all accounts: one query shape, no rewiring when an account crosses a threshold. Finer grain (day) for InternalAccount&lt;br&gt;• Eviction drops whole group when all its members are out of the required time window.&amp;nbsp;&lt;br&gt;• Lock contention moves off the hub account; on Infinigraph a hub&#39;s edge properties spread across shards, one group each&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="460" y="1138" as="geometry" />
        </mxCell>
        <mxCell id="c88" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="MATCH&amp;nbsp;(a:Account&amp;nbsp;{accountId:&amp;nbsp;$from}),&amp;nbsp;(b:Account&amp;nbsp;{accountId:&amp;nbsp;$to})&lt;br&gt;MERGE&amp;nbsp;(ga:TransactionGroup&amp;nbsp;{groupKey:&amp;nbsp;$from&amp;nbsp;+&amp;nbsp;&#39;|&#39;&amp;nbsp;+&amp;nbsp;$period})&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;ga.period&amp;nbsp;=&amp;nbsp;$period&lt;br&gt;MERGE&amp;nbsp;(gb:TransactionGroup&amp;nbsp;{groupKey:&amp;nbsp;$to&amp;nbsp;+&amp;nbsp;&#39;|&#39;&amp;nbsp;+&amp;nbsp;$period})&amp;nbsp;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;gb.period&amp;nbsp;=&amp;nbsp;$period&lt;br&gt;MERGE&amp;nbsp;(a)-[:HAS_TXN_GROUP]-&amp;gt;(ga)&amp;nbsp;MERGE&amp;nbsp;(b)-[:HAS_TXN_GROUP]-&amp;gt;(gb)&lt;br&gt;MERGE&amp;nbsp;(t:Transaction&amp;nbsp;{transactionId:&amp;nbsp;$txId})&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;t.amountMinor&amp;nbsp;=&amp;nbsp;$amountMinor,&amp;nbsp;t.bookedAt&amp;nbsp;=&amp;nbsp;datetime($bookedAt),&amp;nbsp;t.isNew&amp;nbsp;=&amp;nbsp;true&lt;br&gt;WITH&amp;nbsp;ga,&amp;nbsp;gb,&amp;nbsp;t&amp;nbsp;WHERE&amp;nbsp;t.isNew&lt;br&gt;CREATE&amp;nbsp;(ga)-[:SENT]-&amp;gt;(t)-[:CREDITED_TO]-&amp;gt;(gb)&amp;nbsp;REMOVE&amp;nbsp;t.isNew" vertex="1">
          <mxGeometry height="124" width="796" x="52" y="1368" as="geometry" />
        </mxCell>
        <mxCell id="c89" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="1960" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="c90" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontFamily=Helvetica;" value="Current status: a relationship type, never a CurrentAddress label" vertex="1">
          <mxGeometry height="34" width="820" x="1960" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="c91" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; Applies to every P2 and P3 relationship: HAS_ / HAD_ already carries current or ended" vertex="1">
          <mxGeometry height="32" width="796" x="1972" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="c92" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Party&lt;br&gt;A" vertex="1">
          <mxGeometry height="66" width="66" x="1999" y="1655" as="geometry" />
        </mxCell>
        <mxCell id="c93" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Party&lt;br&gt;B" vertex="1">
          <mxGeometry height="66" width="66" x="1999" y="1785" as="geometry" />
        </mxCell>
        <mxCell id="c94" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#4c8eda;strokeColor=#2870c2;fontColor=#ffffff;" value="Address" vertex="1">
          <mxGeometry height="80" width="80" x="2252" y="1713" as="geometry" />
        </mxCell>
        <mxCell id="c95" edge="1" parent="1" source="c92" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c94" value="&lt;b&gt;HAS_ADDRESS&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{current for A}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c96" edge="1" parent="1" source="c93" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#94a3b8;dashed=1;strokeWidth=1.5;" target="c94" value="&lt;b&gt;HAD_ADDRESS&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{former for B}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c97" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontFamily=Helvetica;" value="The same Address is current and former at once. A label on it is wrong for one of them." vertex="1">
          <mxGeometry height="20" width="400" x="1972" y="1856" as="geometry" />
        </mxCell>
        <mxCell id="c98" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=10;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Rule&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Shared nodes&lt;/b&gt; (Address, Phone, Email, IdentityDocument): current is a fact of the link, so it cannot be a label on the node&lt;br&gt;&amp;bull; &lt;b&gt;Per-party nodes&lt;/b&gt; (PartyName, PartyStatus, RiskScore): a Current label would be correct but duplicates the type: two writes that drift (the guideline bans isCurrent for the same reason)&lt;br&gt;&amp;bull; &lt;b&gt;UI:&lt;/b&gt; style by relationship type, HAS_ solid and HAD_ dashed, as in these diagrams&lt;br&gt;&amp;bull; &lt;b&gt;Infinigraph:&lt;/b&gt; the type is already free to filter on the graph shard; a label adds nothing" vertex="1">
          <mxGeometry height="222" width="388" x="2380" y="1628" as="geometry" />
        </mxCell>
        <mxCell id="c99" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="//&amp;nbsp;current&amp;nbsp;addresses:&amp;nbsp;the&amp;nbsp;type&amp;nbsp;is&amp;nbsp;the&amp;nbsp;filter&lt;br&gt;MATCH&amp;nbsp;(p:Party&amp;nbsp;{partyId:&amp;nbsp;$partyId})-[:HAS_ADDRESS]-&amp;gt;(a:Address)&amp;nbsp;RETURN&amp;nbsp;a&lt;br&gt;&lt;br&gt;//&amp;nbsp;every&amp;nbsp;address&amp;nbsp;ever&amp;nbsp;held&lt;br&gt;MATCH&amp;nbsp;(p:Party&amp;nbsp;{partyId:&amp;nbsp;$partyId})-[r:HAS_ADDRESS|HAD_ADDRESS]-&amp;gt;(a:Address)&lt;br&gt;RETURN&amp;nbsp;a,&amp;nbsp;r.validFrom,&amp;nbsp;r.validTo,&amp;nbsp;type(r)&amp;nbsp;=&amp;nbsp;&#39;HAS_ADDRESS&#39;&amp;nbsp;AS&amp;nbsp;isCurrent" vertex="1">
          <mxGeometry height="124" width="796" x="1972" y="1858" as="geometry" />
        </mxCell>
        <mxCell id="C9jO9Z9xZguSy_90JvZP-2" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="880" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="C9jO9Z9xZguSy_90JvZP-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontFamily=Helvetica;" value="P8: Provenance" vertex="1">
          <mxGeometry height="34" width="820" x="880" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="C9jO9Z9xZguSy_90JvZP-1" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=20;" value="&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; unicode-bidi: plaintext; color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 21px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(243, 243, 243); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;Every node and every sourced relationship carries:&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;table style=&quot;border-collapse: collapse; border: 1px solid var(--app-input-border); color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 21px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(243, 243, 243); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;Property&lt;/th&gt;&lt;th style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;Meaning&lt;/th&gt;&lt;th style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;&lt;br&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;&lt;code style=&quot;font-family: var(--app-monospace-font-family); color: var(--app-inline-code-foreground); background: var(--app-inline-code-background); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;sourceSystem&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;System of record the fact came from (&lt;code style=&quot;font-family: var(--app-monospace-font-family); color: var(--app-inline-code-foreground); background: var(--app-inline-code-background); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;CRM&lt;/code&gt;,&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;code style=&quot;font-family: var(--app-monospace-font-family); color: var(--app-inline-code-foreground); background: var(--app-inline-code-background); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;CORE_BANKING&lt;/code&gt;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;&lt;code style=&quot;font-family: var(--app-monospace-font-family); color: var(--app-inline-code-foreground); background: var(--app-inline-code-background); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;sourceUpdatedAt&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;When the source says the fact last changed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;&lt;code style=&quot;font-family: var(--app-monospace-font-family); color: var(--app-inline-code-foreground); background: var(--app-inline-code-background); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;ingestedAt&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;When the graph last wrote it&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;&lt;code style=&quot;font-family: var(--app-monospace-font-family); color: var(--app-inline-code-foreground); background: var(--app-inline-code-background); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;loadId&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;unicode-bidi: plaintext; border: 1px solid var(--app-input-border); padding: 2px;&quot;&gt;The Day 0 batch ID, or the Kafka topic-partition-offset&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; unicode-bidi: plaintext; color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 21px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(243, 243, 243); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
