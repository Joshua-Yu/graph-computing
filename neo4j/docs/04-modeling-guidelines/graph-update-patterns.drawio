          <mxGeometry height="80" width="80" x="912" y="248" as="geometry" />
        </mxCell>
        <mxCell id="c17" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#f79767;strokeColor=#f36924;fontColor=#ffffff;" value="PartyName&lt;br&gt;v2" vertex="1">
          <mxGeometry height="70" width="70" x="1187" y="183" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#475569;dashed=1;" value="PartyName&lt;br&gt;v1" vertex="1">
          <mxGeometry height="70" width="70" x="1187" y="328" as="geometry" />
        </mxCell>
        <mxCell id="c19" edge="1" parent="1" source="c16" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#16a34a;strokeWidth=2;" target="c17" value="&lt;span style=&quot;color: rgb(0, 102, 0);&quot;&gt;&lt;b&gt;HAS_NAME&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;{validFrom: 2026-10-01}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" edge="1" parent="1" source="c16" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#94a3b8;dashed=1;strokeWidth=1.5;" target="c18" value="&lt;span style=&quot;color: rgb(153, 0, 0);&quot;&gt;&lt;b&gt;HAD_NAME&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;{validFrom: 2019-03-04, validTo: 2026-10-01}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c21" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#475569;fontFamily=Helvetica;" value="Green: written by this change. Grey dashed: retyped, nothing deleted." vertex="1">
          <mxGeometry height="20" width="400" x="892" y="400" as="geometry" />
        </mxCell>
        <mxCell id="c22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• Define the &lt;b&gt;scope&lt;/b&gt; of &quot;one current&quot; per &lt;b&gt;&lt;i&gt;scenario&lt;/i&gt;&lt;/b&gt;. Dual citizens hold two valid passports: the scope is party + issuing country.&lt;br&gt;• Closing the old and opening the new happen in &lt;b&gt;one transaction&lt;/b&gt;; the old validTo = the new validFrom&lt;/div&gt;&lt;div&gt;• Update of target node (`PartyName v2` in this case) follows P1.&lt;br&gt;• Guard on order: ignore an event older than the open period (a late event becomes a closed historical period)&lt;br&gt;• Same value again: no new instance&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="1300" y="178" as="geometry" />
        </mxCell>
        <mxCell id="c23" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="MATCH&amp;nbsp;(p:Party&amp;nbsp;{partyId:&amp;nbsp;$partyId})&lt;br&gt;OPTIONAL&amp;nbsp;MATCH&amp;nbsp;(p)-[r:HAS_NAME]-&amp;gt;(old)&lt;br&gt;WITH&amp;nbsp;p,&amp;nbsp;r,&amp;nbsp;old&amp;nbsp;WHERE&amp;nbsp;r&amp;nbsp;IS&amp;nbsp;NULL&amp;nbsp;OR&amp;nbsp;r.validFrom&amp;nbsp;&amp;lt;&amp;nbsp;date($from)&amp;nbsp;&amp;nbsp;//&amp;nbsp;a&amp;nbsp;late&amp;nbsp;event&amp;nbsp;is&amp;nbsp;written&amp;nbsp;as&amp;nbsp;HAD_NAME&amp;nbsp;instead&lt;br&gt;FOREACH&amp;nbsp;(_&amp;nbsp;IN&amp;nbsp;CASE&amp;nbsp;WHEN&amp;nbsp;r&amp;nbsp;IS&amp;nbsp;NULL&amp;nbsp;THEN&amp;nbsp;[]&amp;nbsp;ELSE&amp;nbsp;[1]&amp;nbsp;END&amp;nbsp;|&lt;br&gt;&amp;nbsp;&amp;nbsp;CREATE&amp;nbsp;(p)-[:HAD_NAME&amp;nbsp;{validFrom:&amp;nbsp;r.validFrom,&amp;nbsp;validTo:&amp;nbsp;date($from)}]-&amp;gt;(old)&lt;br&gt;&amp;nbsp;&amp;nbsp;DELETE&amp;nbsp;r)&lt;br&gt;CREATE&amp;nbsp;(p)-[:HAS_NAME&amp;nbsp;{validFrom:&amp;nbsp;date($from)}]-&amp;gt;(:PartyName&amp;nbsp;{nameKey:&amp;nbsp;$nameKey,&amp;nbsp;fullName:&amp;nbsp;$fullName})&lt;br&gt;SET&amp;nbsp;p.displayName&amp;nbsp;=&amp;nbsp;$fullName" vertex="1">
          <mxGeometry height="124" width="796" x="892" y="408" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="c25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontFamily=Helvetica;" value="P3 · Relationship - Slow change, several valid at once: open and close each one independently" vertex="1">
          <mxGeometry height="34" width="820" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; HAS_EMAIL, HAS_PHONE, HAS_ADDRESS (several usages), ABN via IDENTIFIED_BY, multi-valued PartyStatus (CITIZENSHIP)" vertex="1">
          <mxGeometry height="32" width="796" x="52" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c27" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Party" vertex="1">
          <mxGeometry height="80" width="80" x="72" y="728" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#4c8eda;strokeColor=#2870c2;fontColor=#ffffff;" value="Phone A" vertex="1">
          <mxGeometry height="56" width="56" x="354" y="660" as="geometry" />
        </mxCell>
        <mxCell id="c29" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#4c8eda;strokeColor=#2870c2;fontColor=#ffffff;" value="Phone B" vertex="1">
          <mxGeometry height="56" width="56" x="354" y="740" as="geometry" />
        </mxCell>
        <mxCell id="c30" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#475569;dashed=1;" value="Phone C" vertex="1">
          <mxGeometry height="56" width="56" x="354" y="820" as="geometry" />
        </mxCell>
        <mxCell id="c31" edge="1" parent="1" source="c27" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" target="c28" value="&lt;b&gt;HAS_PHONE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{usage: MOBILE, validFrom}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c32" edge="1" parent="1" source="c27" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#16a34a;strokeWidth=2;" target="c29" value="&lt;b&gt;HAS_PHONE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{usage: WORK, validFrom}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" edge="1" parent="1" source="c27" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#94a3b8;dashed=1;strokeWidth=1.5;" target="c30" value="&lt;b&gt;HAD_PHONE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 8px;&#39;&gt;{validFrom, validTo}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c34" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=12;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#1e293b;" value="&lt;b&gt;Write rule&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;• Opening one never closes another. &lt;b&gt;Only close what the source says has ended&lt;/b&gt;: an inferred closure hides evidence&lt;br&gt;• Relationship identity: party + target node + validFrom, so a replayed event is a no-op&lt;br&gt;• Delta source (CDC): apply each open or close event as it comes&lt;br&gt;• Snapshot source (full list per party): diff against the open set; close the missing ones with validTo = snapshot date&lt;br&gt;• The target node itself follows P1: the phone number never changes&lt;/div&gt;" vertex="1">
          <mxGeometry height="222" width="388" x="460" y="658" as="geometry" />
        </mxCell>
        <mxCell id="c35" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=8;fontSize=9;fontFamily=Courier New;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#e2e8f0;" value="//&amp;nbsp;open&lt;br&gt;MATCH&amp;nbsp;(p:Party&amp;nbsp;{partyId:&amp;nbsp;$partyId}),&amp;nbsp;(ph:Phone&amp;nbsp;{number:&amp;nbsp;$e164})&lt;br&gt;MERGE&amp;nbsp;(p)-[r:HAS_PHONE&amp;nbsp;{validFrom:&amp;nbsp;date($from)}]-&amp;gt;(ph)&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;CREATE&amp;nbsp;SET&amp;nbsp;r.usage&amp;nbsp;=&amp;nbsp;$usage,&amp;nbsp;r.sourceSystem&amp;nbsp;=&amp;nbsp;$sourceSystem&lt;br&gt;//&amp;nbsp;close:&amp;nbsp;the&amp;nbsp;one&amp;nbsp;named&amp;nbsp;by&amp;nbsp;the&amp;nbsp;event,&amp;nbsp;nothing&amp;nbsp;else&lt;br&gt;MATCH&amp;nbsp;(p:Party&amp;nbsp;{partyId:&amp;nbsp;$partyId})-[r:HAS_PHONE]-&amp;gt;(ph:Phone&amp;nbsp;{number:&amp;nbsp;$e164})&lt;br&gt;CREATE&amp;nbsp;(p)-[:HAD_PHONE&amp;nbsp;{validFrom:&amp;nbsp;r.validFrom,&amp;nbsp;validTo:&amp;nbsp;date($to),&amp;nbsp;usage:&amp;nbsp;r.usage}]-&amp;gt;(ph)&amp;nbsp;DELETE&amp;nbsp;r" vertex="1">
          <mxGeometry height="124" width="796" x="52" y="888" as="geometry" />
        </mxCell>
        <mxCell id="c36" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="440" width="820" x="880" y="580" as="geometry" />
        </mxCell>
        <mxCell id="c37" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=15;fontStyle=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#FF9999;fontFamily=Helvetica;" value="P4 · Relationship - Fast change, smallappend only: every event is a new node, never edited" vertex="1">
          <mxGeometry height="34" width="820" x="880" y="580" as="geometry" />
        </mxCell>
