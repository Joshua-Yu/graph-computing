        <mxCell id="c1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f3864;fontFamily=Helvetica;" value="Nexus Network Search - Graph Update Patterns (v0.2)&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Last udpated: 2026-10-22&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; font-weight: normal;&quot;&gt;Notes: sample Cypher statements are still WIP.&lt;/font&gt;&lt;/div&gt;" vertex="1">
