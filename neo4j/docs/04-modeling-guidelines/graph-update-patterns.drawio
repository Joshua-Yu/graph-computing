          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" parent="1" source="d5" target="r2" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#475569;strokeWidth=1.2;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" parent="1" source="d5" target="r3" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=9;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#475569;strokeWidth=1.2;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=10;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;A value that supersedes the previous one is P2, however often it changes.&lt;/b&gt; RiskScore is P2 (one current per model) with write-on-change, not P4.&lt;br&gt;&lt;br&gt;&lt;b&gt;P2 needs a scope.&lt;/b&gt; Write it down per type: name per party; licence per party + state; passport per party + country; AML status per party.&lt;br&gt;&lt;br&gt;&lt;b&gt;P3 never infers closure.&lt;/b&gt; If the source does not say a phone has ended, it stays open.&lt;br&gt;&lt;br&gt;&lt;b&gt;Transactions are P7 for every account.&lt;/b&gt; A threshold would give two query shapes and force rewiring when an account crosses it." vertex="1">
          <mxGeometry x="40" y="840" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontFamily=Helvetica;align=left;spacing=10;fontSize=11;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;Element mapping&lt;/b&gt;&lt;br&gt;&lt;table style=&#39;font-size: 11px; border-collapse: collapse;&#39; cellpadding=&#39;4&#39;&gt;&lt;tr style=&#39;border-bottom: 1px solid #94a3b8;&#39;&gt;&lt;td&gt;&lt;b&gt;Node&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Node pattern&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Relationships from or to it&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Party&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;POSSIBLY_SAME_AS: P1 (derived link, added once)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Phone, Email&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;HAS_PHONE, HAS_EMAIL: P3&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;IdentityDocument&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;IDENTIFIED_BY: P2 for licence and passport (scoped), P3 for ABN and ACN&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Address&lt;/td&gt;&lt;td&gt;P6&lt;/td&gt;&lt;td&gt;HAS_ADDRESS: P3 (one per usage only if the source guarantees it: then P2)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;PartyName&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;HAS_NAME: P2, scope party&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;PartyStatus&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;HAS_STATUS: P2 for single-valued domains (AML, RESIDENCY), P3 for CITIZENSHIP, TAX_RESIDENCY&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;RiskScore&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;HAS_RISK_SCORE: P2, scope party + model, write on change&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;TransactionGroup&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;HAS_TXN_GROUP from Account: P1, once per account and period&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Transaction&lt;/td&gt;&lt;td&gt;P4, grouped by P7&lt;/td&gt;&lt;td&gt;SENT from, CREDITED_TO to a TransactionGroup; INITIATED_FROM: created with the transaction&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Alert&lt;/td&gt;&lt;td&gt;P4&lt;/td&gt;&lt;td&gt;RAISED_ON: P4&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Account&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;TRANSFERRED_TO: P5&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Device, IpAddress&lt;/td&gt;&lt;td&gt;P1&lt;/td&gt;&lt;td&gt;USED_DEVICE, SEEN_AT: P5&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;border-bottom: 1px solid #e2e8f0;&#39;&gt;&lt;td&gt;Product, country, currency codes&lt;/td&gt;&lt;td&gt;P6 as properties&lt;/td&gt;&lt;td&gt;none: not nodes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;font style=&#39;font-size: 10px;&#39;&gt;Per-party history nodes (PartyName, PartyStatus, RiskScore) are P1 themselves: once written they never change. Their history is carried by the P2 / P3 relationship.&lt;/font&gt;" vertex="1">
          <mxGeometry x="960" y="100" width="760" height="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
