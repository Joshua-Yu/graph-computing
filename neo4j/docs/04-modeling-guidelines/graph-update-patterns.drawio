        </mxCell>
        <mxCell id="c5" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#334155;fontFamily=Helvetica;" value="&lt;b&gt;Examples:&lt;/b&gt; Party; also every identity node keyed on its value: Phone, Email, IdentityDocument" vertex="1">
          <mxGeometry height="32" width="796" x="52" y="140" as="geometry" />
