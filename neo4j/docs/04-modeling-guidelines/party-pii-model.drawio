        <mxCell id="g_note" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;whiteSpace=wrap;fontFamily=Helvetica;" value="Free to filter on: labels, relationship types, structure" vertex="1">
          <mxGeometry x="60" y="580" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="zone_1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontStyle=1;fillColor=#ffedd5;strokeColor=#ea580c;dashed=1;fontColor=#9a3412;fontFamily=Helvetica;" value="Property shard 1" vertex="1">
          <mxGeometry x="960" y="100" width="780" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s1a" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;Party A&lt;/b&gt;&lt;br&gt;{partyId, displayName,&lt;br&gt;riskScore, ...}" vertex="1">
