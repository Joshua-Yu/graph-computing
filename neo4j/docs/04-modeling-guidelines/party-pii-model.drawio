        <mxCell id="rs0_p" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;" value="band MEDIUM, model FRAUD_V3" vertex="1">
          <mxGeometry x="905" y="862" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="e_rs0" parent="1" source="party" target="rs0" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#94a3b8;dashed=1;strokeWidth=1.5;" value="&lt;b&gt;HAD_RISK_SCORE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 9px;&#39;&gt;{validFrom, validTo}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pairs" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;Type pairs&lt;/b&gt;&lt;br&gt;&lt;table style=&#39;font-size: 11px;&#39;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Open (no validTo)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;&amp;nbsp;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Ended (always validTo)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HAS_ADDRESS&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;HAD_ADDRESS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HAS_PHONE&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;HAD_PHONE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HAS_EMAIL&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;HAD_EMAIL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HAS_NAME&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;HAD_NAME&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HAS_STATUS&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;HAD_STATUS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;HAS_RISK_SCORE&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;HAD_RISK_SCORE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;IDENTIFIED_BY&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;WAS_IDENTIFIED_BY&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry x="1180" y="110" width="330" height="210" as="geometry" />
        </mxCell>
        <mxCell id="closing" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;Closing a period&lt;/b&gt;&lt;br&gt;Delete the open relationship and create the ended one (same properties plus validTo) in one transaction. History is kept.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why before Day 0&lt;/b&gt;&lt;br&gt;Traversals skip ended links by type on a single graph and on Infinigraph. Retrofitting means rewriting every time-variant relationship." vertex="1">
          <mxGeometry x="1180" y="340" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="naming" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;Naming (§7.3)&lt;/b&gt;&lt;br&gt;HAS_EMAIL_CURRENT or HAS_CURRENT_EMAIL works the same way; the ADR picks one.&lt;br&gt;&lt;b&gt;Not allowed:&lt;/b&gt; HAS_EMAIL for every period plus a second current-only copy. The copies drift." vertex="1">
          <mxGeometry x="1180" y="500" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="score" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;RiskScore history (D7)&lt;/b&gt;&lt;br&gt;A new node only when the outcome changes (new band, or a move above the threshold). A rescore with the same outcome updates lastConfirmedAt. One open score per model. Party keeps a copy of the current score so filters stay fast." vertex="1">
          <mxGeometry x="1180" y="610" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="later" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;Only on a move to Infinigraph (D3–D6, backfilled at migration)&lt;/b&gt;&lt;br&gt;&amp;bull; Status and risk-band labels on Party, e.g. :HighRisk, :PEP&lt;br&gt;&amp;bull; :HighDegree label in place of isHighDegree&lt;br&gt;&amp;bull; No uniqueness constraints; MATCH / CREATE in place of MERGE&lt;br&gt;&amp;bull; Personal information restricted by label, not property" vertex="1">
          <mxGeometry x="1180" y="730" width="560" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="infinigraph_lpg" name="Infinigraph placement">
