        <mxCell id="addr0_p" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;" value="&lt;b&gt;addressId&lt;/b&gt;: former" vertex="1">
