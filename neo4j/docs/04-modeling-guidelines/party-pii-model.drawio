        <mxCell id="rs1" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#8b5cf6;strokeColor=#6d28d9;fontColor=#ffffff;" value="RiskScore" vertex="1">
          <mxGeometry x="808.0" y="698.0" width="84" height="84" as="geometry" />
