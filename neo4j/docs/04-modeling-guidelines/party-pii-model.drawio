        <mxCell id="pb" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#1f3864;strokeColor=#14254a;fontColor=#ffffff;" value="Party B&lt;br&gt;&lt;font style=&#39;font-size: 9px; font-weight: normal;&#39;&gt;:Party:Person&lt;/font&gt;" vertex="1">
          <mxGeometry x="705.0" y="305.0" width="110" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" source="pa" target="em" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" value="&lt;b&gt;HAS_EMAIL&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" source="pa" target="ad" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" value="&lt;b&gt;HAS_ADDRESS&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" source="pb" target="ad" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" value="&lt;b&gt;HAS_ADDRESS&lt;/b&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g_note" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;whiteSpace=wrap;fontFamily=Helvetica;" value="Free to filter on: labels, relationship types, structure" vertex="1">
          <mxGeometry x="60" y="580" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="zone_1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontStyle=1;fillColor=#ffedd5;strokeColor=#ea580c;dashed=1;fontColor=#9a3412;fontFamily=Helvetica;" value="Property shard 1" vertex="1">
          <mxGeometry x="960" y="100" width="780" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s1a" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;Party A&lt;/b&gt;&lt;br&gt;{partyId, displayName,&lt;br&gt;riskScore, ...}" vertex="1">
          <mxGeometry x="980" y="140" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1b" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;A -[:HAS_EMAIL]-&gt;&lt;/b&gt;&lt;br&gt;{usage, validFrom}" vertex="1">
          <mxGeometry x="1220" y="140" width="240" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s1c" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;A -[:HAS_ADDRESS]-&gt;&lt;/b&gt;&lt;br&gt;{usage, validFrom}" vertex="1">
          <mxGeometry x="1480" y="140" width="240" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s1n" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;whiteSpace=wrap;fontFamily=Helvetica;" value="A node&#39;s properties travel with its outgoing relationships&#39; properties: one fetch per party." vertex="1">
          <mxGeometry x="980" y="225" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="zone_2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontStyle=1;fillColor=#ffedd5;strokeColor=#ea580c;dashed=1;fontColor=#9a3412;fontFamily=Helvetica;" value="Property shard 2" vertex="1">
          <mxGeometry x="960" y="290" width="780" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s2a" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;Party B&lt;/b&gt;&lt;br&gt;{partyId, displayName, ...}" vertex="1">
          <mxGeometry x="980" y="330" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s2b" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;B -[:HAS_ADDRESS]-&gt;&lt;/b&gt;&lt;br&gt;{usage, validFrom}" vertex="1">
          <mxGeometry x="1220" y="330" width="240" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s2n" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;whiteSpace=wrap;fontFamily=Helvetica;" value="Many residents on one Address: no skew, each link&#39;s properties live with its party." vertex="1">
          <mxGeometry x="980" y="395" width="740" height="20" as="geometry" />
        </mxCell>
        <mxCell id="zone_3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontStyle=1;fillColor=#ffedd5;strokeColor=#ea580c;dashed=1;fontColor=#9a3412;fontFamily=Helvetica;" value="Property shard 3" vertex="1">
          <mxGeometry x="960" y="450" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3a" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;Email&lt;/b&gt;&lt;br&gt;{address}" vertex="1">
          <mxGeometry x="980" y="490" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3b" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#334155;" value="&lt;b&gt;Address&lt;/b&gt;&lt;br&gt;{addressId, gnafPid, dpid}" vertex="1">
          <mxGeometry x="1220" y="490" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rules" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;What this means for the party model&lt;/b&gt;&lt;br&gt;&amp;bull; Shape every query as: one indexed seed (partyId) &amp;rarr; traverse on labels and types only &amp;rarr; fetch properties once at the end&lt;br&gt;&amp;bull; A property test mid-pattern (validFrom, usage, riskBand) forces a cross-shard fetch per candidate: §7.4 decides when to promote one to a type or label&lt;br&gt;&amp;bull; HAS_ / HAD_ (D1) makes &quot;current only&quot; a type filter, free on the graph shard&lt;br&gt;&amp;bull; Date filters inside quantified paths: §8 (fixed windows as markers, SHARES_IDENTIFIER_WITH for overlap, or traverse first and filter after)&lt;br&gt;&amp;bull; MERGE and uniqueness checks cross shards: keys resolved upstream in Orchestra (§9)&lt;br&gt;&amp;bull; Property-level access control is unavailable: tax numbers and other restricted data sit on their own labelled nodes (§6)" vertex="1">
          <mxGeometry x="40" y="660" width="1100" height="160" as="geometry" />
        </mxCell>
        <mxCell id="verdict" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fontSize=11;spacing=10;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;" value="&lt;b&gt;Current verdict&lt;/b&gt;&lt;br&gt;Not needed yet: the whole graph fits one instance (architecture doc, Infinigraph decision). D1, D2 and D7 are adopted before Day 0 because they are expensive to retrofit. D3–D6 are cheap backfills, applied only if a move is decided." vertex="1">
          <mxGeometry x="1170" y="660" width="570" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="party_profiles" name="Party profiles">
    <mxGraphModel dx="1243" dy="661" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f3864;fontFamily=Helvetica;" value="Party profiles: six groups behind one PartyProfile node" vertex="1">
          <mxGeometry height="30" width="1300" x="40" y="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;whiteSpace=wrap;fontFamily=Helvetica;" value="Derived features for request-time risk scoring and investigation. Each group keeps its current top N (purple) and its N most recent drop-outs (grey dashed). Values are as of the end-of-day watermark; scoring adds activity since then. Ranks 2 to N-1 are not drawn. See party-pii-modeling-guideline.md §3.5." vertex="1">
