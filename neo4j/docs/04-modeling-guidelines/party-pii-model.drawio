        <mxCell id="e_rs1" parent="1" source="party" target="rs1" edge="1" style="html=1;rounded=0;endArrow=classic;endFill=1;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;fontFamily=Helvetica;strokeColor=#1f3864;strokeWidth=1.5;" value="&lt;b&gt;HAS_RISK_SCORE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size: 9px;&#39;&gt;{validFrom}&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rs0" parent="1" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;strokeWidth=2;fontFamily=Helvetica;fillColor=#ddd6fe;strokeColor=#8b5cf6;fontColor=#1e293b;dashed=1;" value="RiskScore" vertex="1">
          <mxGeometry x="808.0" y="838.0" width="84" height="84" as="geometry" />
