        <mxCell id="rs1_p" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;spacing=6;fontSize=10;fontFamily=Helvetica;align=left;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;" value="band HIGH, model FRAUD_V3&lt;br&gt;lastConfirmedAt updated on rescore" vertex="1">
          <mxGeometry x="905" y="722" width="220" height="36" as="geometry" />
