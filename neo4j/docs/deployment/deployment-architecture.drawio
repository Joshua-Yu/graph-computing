        <mxCell id="infinigraph_future_c47" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontSize=11;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;Backups&lt;/b&gt;: one chain per shard · property shard chains hold one full backup, no differentials · N-way coordinated restore rehearsed in NFT" vertex="1">
