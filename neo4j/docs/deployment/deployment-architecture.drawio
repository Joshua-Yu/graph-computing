        </mxCell>
        <mxCell id="infinigraph_future_c52" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f6f9;strokeColor=#0e7490;fontSize=10;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;dashed=1;" value="&lt;b&gt;Property shard replicas&lt;/b&gt;&lt;br&gt;1 copy of each of 8 shards&lt;br&gt;&lt;i&gt;to confirm with Neo4j (D10)&lt;/i&gt;" vertex="1">
          <mxGeometry x="1295" y="400" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="infinigraph_future_c53" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=10;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;" value="Replicas outside the Sydney Raft group are not Raft members (M = F + 1). Confirm residency, routing and recovery behaviour before adopting." vertex="1">
          <mxGeometry x="1295" y="510" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="infinigraph_future_c54" parent="1" source="infinigraph_future_c11" target="infinigraph_future_c51" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0e7490;strokeWidth=1.5;fontSize=9;fontColor=#334155;labelBackgroundColor=#ffffff;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="async · TGW peering">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="955" y="210" />
              <mxPoint x="1395" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="infinigraph_future_c55" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontSize=11;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;Trigger (all must hold)&lt;/b&gt;&lt;br&gt;• Hot working set &amp;gt; ~70% of the largest acceptable instance, with 12 months of growth ahead, after cold properties are moved out&lt;br&gt;• Properties ≥ ~2× topology on disk&lt;br&gt;• Topology + indexes fit one host with 3 years of headroom&lt;br&gt;• No PBAC need · residency accepted · per-shard RPO validated · team staffed for 9+ stateful members" vertex="1">
          <mxGeometry x="1530" y="80" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="infinigraph_future_c56" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontSize=11;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;Done from day one (Year 1)&lt;/b&gt;&lt;br&gt;• Release supporting sharded property databases · block format · Cypher 25&lt;br&gt;• Database alias for every client&lt;br&gt;• Shard-safe loaders: upstream identity, MATCH/CREATE + UNWIND, no MERGE on hot paths&lt;br&gt;• Model filters as types and labels; outgoing anchoring&lt;br&gt;• No PBAC, composite DBs or dbms.setConfigValue()&lt;br&gt;• Cold properties kept out of the graph&lt;br&gt;• IP space + node group reserved" vertex="1">
          <mxGeometry x="1530" y="305" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="infinigraph_future_c57" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;Migration path&lt;/b&gt;&lt;br&gt;1. Rehearse in NFT at PROD scale&lt;br&gt;2. Provision property servers&lt;br&gt;3. neo4j-admin database copy into a new sharded database, online from a backup&lt;br&gt;4. Replay Kafka to catch up&lt;br&gt;5. Reconcile, then ALTER ALIAS networksearch&lt;br&gt;6. Keep the old database until sign-off" vertex="1">
          <mxGeometry x="1530" y="560" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="infinigraph_future_c58" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;fontColor=#1e293b;fontFamily=Helvetica;spacingLeft=4;spacingRight=4;" value="&lt;b&gt;What changes for operations&lt;/b&gt;&lt;br&gt;• 9+ stateful members instead of 5&lt;br&gt;• Per-shard backup chains&lt;br&gt;• Monitor shard size skew (super-hubs) and fan-out p99&lt;br&gt;• Config by ALTER DATABASE&lt;br&gt;• An extra Infinigraph subscription on top of Enterprise, GDS and Hume" vertex="1">
          <mxGeometry x="1530" y="775" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="infinigraph_future_c59" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Helvetica;" value="&lt;b&gt;Legend&lt;/b&gt;" vertex="1">
          <mxGeometry x="40" y="1090" width="80" height="20" as="geometry" />
