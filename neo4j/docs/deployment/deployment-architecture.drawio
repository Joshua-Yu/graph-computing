        <mxCell id="infinigraph_future_c51" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fillColor=#0e7490;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=10;fontStyle=1;fontFamily=Helvetica;" value="Graph secondary&lt;br&gt;UAT + DR seed" vertex="1">
